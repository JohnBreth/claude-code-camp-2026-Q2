#!/usr/bin/env bash
# Usage: bin/00_config [ruby|python]   (default: ruby)
lang="${1:-ruby}"
dir="$(dirname "$0")/../$lang/00_config"

case "$lang" in
  ruby)
    cd "$dir" && bundle exec ruby examples/example.rb
    ;;
  python)
    cd "$dir" || exit 1
    if [ ! -d .venv ]; then
      python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt
    fi
    .venv/bin/python examples/example.py
    ;;
  *)
    echo "Unknown language: $lang (expected ruby or python)" >&2
    exit 1
    ;;
esac
